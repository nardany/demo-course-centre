# PostgreSQL connection string (Neon, Supabase or any Postgres). Tables are created automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Admin panel password
ADMIN_PASSWORD=change-me
# Random string, at least 32 characters, used to sign admin sessions
# Generate with: openssl rand -hex 32
ADMIN_SECRET=
# Optional: read-only demo login shown on the admin login page (prospects can look, nothing is saved)
DEMO_PASSWORD=demo
